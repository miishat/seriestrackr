# Discovery credentials are read only by the local Node service.
# Create .env.discovery.local in the project root containing:
TAVILY_API_KEY=

# Create .env.deepseek.local in the project root containing:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Create .env.google-books.local in the project root containing:
GOOGLE_BOOKS_API_KEY=

# Create .env.hardcover.local in the project root containing:
# Get the token from Hardcover account settings, then the "Hardcover API" link.
# Tokens expire every year on January 1st.
HARDCOVER_API_TOKEN=

# All four files are Git-ignored. Never use VITE_ variables for these keys.
# The service does not load this example or the browser's environment files.
